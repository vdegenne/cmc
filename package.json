{
	"name": "@vdegenne/cmc",
	"version": "0.1.41",
	"description": "cmc",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/vdegenne/cmc"
	},
	"exports": {
		".": {
			"import": "./lib/index.js",
			"types": "./types.d.ts"
		},
		"./data/*": {
			"import": "./data/*"
		},
		"./utils": {
			"import": "./lib/utils.js",
			"types": "./lib/utils.d.ts"
		},
		"./manager": {
			"import": "./lib/CMCManager.js",
			"types": "./lib/CMCManager.d.ts"
		}
	},
	"scripts": {
		"build": "wireit",
		"script:fetch-all": "wireit"
	},
	"files": [
		"./lib/",
		"!./lib/scripts/",
		"./data/",
		"./types.d.ts"
	],
	"devDependencies": {
		"@types/node": "^26.6.6",
		"typescript": "^7.0.2",
		"wireit": "^0.15.0"
	},
	"wireit": {
		"build": {
			"dependencies": [
				"build:ts"
			]
		},
		"build:ts": {
			"command": "tsc --pretty",
			"clean": "if-file-deleted",
			"files": [
				"./tsconfig.json",
				"./src/"
			],
			"output": [
				"./lib/"
			]
		},
		"script:fetch-all": {
			"command": "node ./lib/scripts/fetch-all.js",
			"dependencies": [
				"build:ts"
			],
			"files": [],
			"output": [
				"./data/**/*.json"
			]
		}
	}
}
